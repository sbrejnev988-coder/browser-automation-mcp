# Recommended defaults: raw secrets remain inaccessible.
BROWSER_ALLOW_RAW_COOKIE_VALUES=0
BROWSER_ALLOW_RAW_STORAGE_VALUES=0
BROWSER_ALLOW_SENSITIVE_EXEC=0
BROWSER_ALLOW_SENSITIVE_EXEC_EXFIL=0
BROWSER_ALLOW_NETWORK_BODIES=0
BROWSER_ALLOW_LEGACY_PLAINTEXT_LOGIN=0

# Only needed when an operator deliberately authorizes raw values.
# Use exact registrable domains; '*' is accepted only for current_page scope.
BROWSER_COOKIE_ALLOWED_DOMAINS=example.com

# Shared durable filesystem bridge (optional override).
# BROWSER_MEMORY_WIKI_BRIDGE_DIR=/root/.hermes/memory-wiki/browser_bridge

# Bridge ingestion limits.
MEMORY_WIKI_BROWSER_EVENT_MAX_BYTES=1048576
MEMORY_WIKI_BROWSER_DRAIN_LIMIT=50
